{
  "name": "planner-reviewer",
  "private": true,
  "version": "0.0.1",
  "description": "Code-review agent for Planner diffs (Claude Agent SDK): diff in, structured JSON review out.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "review": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "eval": "npx --yes promptfoo@0.125.1 eval -c evals/promptfooconfig.yaml --env-file .env --no-share",
    "eval:view": "npx --yes promptfoo@0.125.1 view"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
