{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planner",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  // Local E2E build only (playwright.config.ts sets CLOUDFLARE_ENV=e2e so secrets come from .dev.vars.e2e). Empty: it
  // inherits everything above; add any future binding or var here too, since environments do not inherit those.
  "env": {
    "e2e": {},
  },
}
