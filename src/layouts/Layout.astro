---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import AppNav from "@/components/navigation/AppNav.astro";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  title?: string;
}

const { title = "10x Astro Starter" } = Astro.props;
// Signed in exactly as the middleware decides it: a user with no role is signed in too.
const { user, role } = Astro.locals;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-20 focus:rounded-md focus:bg-background focus:px-3 focus:py-2 focus:text-sm focus:ring-2 focus:ring-ring"
    >
      Skip to content
    </a>
    {missingConfigs.map((cfg) => (
      <Banner variant="error">
        <strong>Uwaga:</strong> {cfg.message}
        {cfg.docsUrl && (
          <>
            {" "}
            <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
              {cfg.docsLabel ?? "Dokumentacja"}
            </a>
            .
          </>
        )}
      </Banner>
    ))}
    <AppNav actor={{ signedIn: user !== null, role }} email={user?.email} pathname={Astro.url.pathname} />
    <main id="main" class="flex flex-1 flex-col">
      <slot />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
  }
  /* Only html gets a fixed height: capping body would let long pages overflow past it. Pages fill the rest with flex-1. */
  html {
    height: 100%;
  }
</style>
