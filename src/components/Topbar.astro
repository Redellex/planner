---
import { cn } from "@/lib/utils";

const { user, role } = Astro.locals;
---

<div class="mb-4 flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80">
  {user ? (
    <>
      <span class="flex items-center gap-2 text-blue-100/70">
        {user.email}
        {role && (
          <span
            class:list={cn(
              "rounded-full border px-2 py-0.5 text-xs",
              role === "manager" ? "border-purple-300/40 text-purple-200" : "border-white/20 text-blue-100/70",
            )}
          >
            {role}
          </span>
        )}
      </span>
      <div class="flex items-center gap-3">
        {role === "manager" && (
          <a href="/manager/users" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Users
          </a>
        )}
        {role === "manager" && (
          <a href="/manager/months" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Months
          </a>
        )}
        {role === "manager" && (
          <a
            href="/manager/availability"
            class="text-purple-300 transition-colors hover:text-purple-100 hover:underline"
          >
            Team availability
          </a>
        )}
        <a href="/availability" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Availability
        </a>
        <a href="/dashboard" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Dashboard
        </a>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Sign out
          </button>
        </form>
      </div>
    </>
  ) : (
    <>
      <span class="text-blue-100/70">Not signed in</span>
      <div class="flex gap-3">
        <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Sign in
        </a>
        <a href="/auth/signup" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Sign up
        </a>
      </div>
    </>
  )}
</div>
