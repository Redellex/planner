---
// A full-width notice strip above the top bar (e.g. Supabase not configured, from Layout). Error reads as an alert,
// warning and info as a status.
import { CircleAlert, Info, TriangleAlert } from "lucide-react";
import { Alert, AlertDescription } from "@/components/ui/alert";

type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;
const role = variant === "error" ? "alert" : "status";
---

<div class="bg-background px-4 pt-4">
  {variant === "error" ? (
    <Alert variant="destructive" role={role}>
      <CircleAlert aria-hidden="true" />
      <AlertDescription>
        <p>
          <slot />
        </p>
      </AlertDescription>
    </Alert>
  ) : variant === "warning" ? (
    <Alert role={role} className="border-warning/60 text-warning">
      <TriangleAlert aria-hidden="true" />
      <AlertDescription>
        <p>
          <slot />
        </p>
      </AlertDescription>
    </Alert>
  ) : (
    <Alert role={role}>
      <Info aria-hidden="true" />
      <AlertDescription>
        <p>
          <slot />
        </p>
      </AlertDescription>
    </Alert>
  )}
</div>
