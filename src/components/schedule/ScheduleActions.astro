---
import { CircleAlert, CircleCheck } from "lucide-react";
import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert";
import { Button, buttonVariants } from "@/components/ui/button";
import { formatMonth, formatStationInstant } from "@/lib/availability";
import { managerScheduleUrl } from "@/lib/schedule";

interface Props {
  month: string;
  /** The selected station day, kept in the regenerate and cancel links. */
  day: string;
  /** Whether a draft can be generated for `month` (one of the next 3 months). */
  canGenerate: boolean;
  /** The stored draft, or null when the month has none; `publishedAt` is null while it is a draft. */
  draft: { generatedAt: string; publishedAt: string | null } | null;
  /** How many station days of the draft have no one assigned; Publish is offered only at 0. */
  daysWithNoOne: number;
  /** Whether the month's availability is already locked. */
  locked: boolean;
  /** Renders the regenerate confirmation instead of the Regenerate link (`?confirm=replace`). */
  confirming: boolean;
  /** Result of the last generate, discard, publish or unpublish. */
  feedback: { kind: "error" | "success"; message: string } | null;
  /** Prepended to every element id; set it when a page renders more than one of these (the kitchen sink). */
  idPrefix?: string;
}

const { month, day, canGenerate, draft, daysWithNoOne, locked, confirming, feedback, idPrefix = "" } = Astro.props;
const monthLabel = formatMonth(month);
const headingId = `${idPrefix}schedule-actions-heading`;
// A published month is frozen: only Unpublish is offered (the app and Postgres refuse every other write).
const publishedAt = draft?.publishedAt ?? null;
const gapsText = daysWithNoOne === 1 ? "1 day has no one" : `${daysWithNoOne} days have no one`;
---

<section
  aria-labelledby={headingId}
  data-schedule-draft={draft ? "" : undefined}
  data-schedule-published={publishedAt ? "" : undefined}
  class="mb-6 rounded-xl border bg-card p-4 text-card-foreground"
>
  <h2 id={headingId} class="mb-3 text-base font-semibold">
    {publishedAt ? "Published" : "Draft"} — {monthLabel}
  </h2>

  {feedback?.kind === "error" && (
    <Alert variant="destructive" className="mb-3">
      <CircleAlert />
      <AlertDescription>{feedback.message}</AlertDescription>
    </Alert>
  )}
  {feedback?.kind === "success" && (
    <Alert role="status" className="mb-3">
      <CircleCheck />
      <AlertTitle>{feedback.message}</AlertTitle>
    </Alert>
  )}

  {draft && publishedAt ? (
    <>
      <p class="mb-3 text-sm text-muted-foreground">Published {formatStationInstant(publishedAt)}</p>
      <form method="POST" action="/api/manager/schedule/unpublish">
        <input type="hidden" name="month" value={month} />
        <Button type="submit" variant="secondary" size="sm" aria-label={`Unpublish the ${monthLabel} schedule`}>
          Unpublish
        </Button>
      </form>
      <p class="mt-3 text-xs text-muted-foreground">
        Unpublish to change, regenerate or discard it; it becomes a draft again. A published month stays locked.
      </p>
    </>
  ) : draft ? (
    <>
      <p class="mb-3 text-sm text-muted-foreground">Generated {formatStationInstant(draft.generatedAt)}</p>
      {canGenerate && confirming && (
        <div class="mb-3 flex flex-col gap-3 rounded-lg border p-3">
          <p class="text-sm">
            Replace the current draft? A new draft is generated from the team's availability and the current one is
            deleted.
          </p>
          <div class="flex flex-wrap items-center gap-2">
            <form method="POST" action="/api/manager/schedule/generate">
              <input type="hidden" name="month" value={month} />
              <input type="hidden" name="confirm" value="replace" />
              <Button type="submit" size="sm">
                Replace draft
              </Button>
            </form>
            <a
              href={managerScheduleUrl({ month, day })}
              class:list={buttonVariants({ variant: "outline", size: "sm" })}
            >
              Cancel
            </a>
          </div>
        </div>
      )}
      <div class="flex flex-wrap items-center gap-2">
        {daysWithNoOne === 0 && (
          <form method="POST" action="/api/manager/schedule/publish">
            <input type="hidden" name="month" value={month} />
            <Button type="submit" size="sm" aria-label={`Publish the ${monthLabel} schedule`}>
              Publish
            </Button>
          </form>
        )}
        {canGenerate && !confirming && (
          <a
            href={managerScheduleUrl({ month, day, confirm: "replace" })}
            class:list={buttonVariants({ variant: "secondary", size: "sm" })}
          >
            Regenerate
          </a>
        )}
        <form method="POST" action="/api/manager/schedule/discard">
          <input type="hidden" name="month" value={month} />
          <Button type="submit" variant="destructive" size="sm" aria-label={`Discard the ${monthLabel} draft`}>
            Discard
          </Button>
        </form>
      </div>
      {daysWithNoOne > 0 && (
        <p class="mt-3 text-sm text-muted-foreground">Assign someone on every day to publish ({gapsText}).</p>
      )}
      <p class="mt-3 text-xs text-muted-foreground">
        Discarding keeps the month locked. Unlock it on
        <a href="/manager/months" class="text-primary underline-offset-4 hover:underline">
          Manage month locks
        </a>
        once the draft is gone; a published month is unpublished first.
      </p>
    </>
  ) : (
    <>
      <p class="mb-3 text-sm text-muted-foreground">No draft for {monthLabel}.</p>
      {canGenerate ? (
        <form method="POST" action="/api/manager/schedule/generate" class="flex flex-col gap-2">
          <input type="hidden" name="month" value={month} />
          <div>
            <Button type="submit" size="sm">
              Generate
            </Button>
          </div>
          <p class="text-xs text-muted-foreground">
            {locked
              ? `${monthLabel} is locked, so the draft uses the availability as it stands.`
              : `Generating locks ${monthLabel}: employees can no longer edit their availability for it.`}
          </p>
        </form>
      ) : (
        <p class="text-xs text-muted-foreground">Drafts can be generated only for the next 3 months.</p>
      )}
    </>
  )}
</section>
