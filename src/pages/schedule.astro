---
import Layout from "@/layouts/Layout.astro";
import MonthTabs from "@/components/availability/MonthTabs.astro";
import PublishedScheduleView from "@/components/published-schedule/PublishedScheduleView.astro";
import { buttonVariants } from "@/components/ui/button";
import { createClient } from "@/lib/supabase";
import { currentStationMonth, monthOfDate, monthStart, parseDate, parseMonth } from "@/lib/availability";
import { loadPublishedSchedule, publishedScheduleUrl, type PublishedSchedule } from "@/lib/published-schedule";
import { scheduleMonths } from "@/lib/schedule";

// Any signed-in user through PROTECTED_ROUTES in src/lib/route-access.ts. The only read is get_published_schedule,
// which returns a month's shifts only while it is published, with names and no emails; drafts never reach this page.
const { user, role } = Astro.locals;
const months = scheduleMonths();
const requestedMonth = parseMonth(Astro.url.searchParams.get("month"));
const month = requestedMonth && months.includes(requestedMonth) ? requestedMonth : currentStationMonth();
const requestedDay = parseDate(Astro.url.searchParams.get("day"));
// Every calendar date of the month starts one station day, so a date of the month is a valid station day.
const selectedDay = requestedDay && monthOfDate(requestedDay) === month ? requestedDay : monthStart(month);

const supabase = createClient(Astro.request.headers, Astro.cookies);
const schedule: PublishedSchedule = supabase ? await loadPublishedSchedule(supabase, month) : { kind: "unknown" };
const monthHref = (option: string): string => publishedScheduleUrl({ month: option });
---

<Layout title="Schedule">
  <div class="min-h-screen bg-background p-4">
    <!-- Only the calendar uses the desktop width (its cells list who works each shift); the rest stays narrow. -->
    <div class="mx-auto w-full max-w-2xl lg:max-w-6xl">
      <div class="mx-auto w-full max-w-2xl">
        <h1 class="mb-6 text-center text-2xl font-semibold">Schedule</h1>
        <MonthTabs months={months} current={month} lockedMonths={new Set()} hrefFor={monthHref} />
      </div>

      <PublishedScheduleView
        month={month}
        selectedDay={selectedDay}
        schedule={schedule}
        ownEmployeeId={user?.id ?? null}
        isManager={role === "manager"}
      />

      <div class="mt-6 text-center">
        <a href="/dashboard" class:list={buttonVariants({ variant: "outline" })}>
          Back to dashboard
        </a>
      </div>
    </div>
  </div>
</Layout>
