---
import { CircleAlert } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import MonthTabs from "@/components/availability/MonthTabs.astro";
import ScheduleActions from "@/components/schedule/ScheduleActions.astro";
import ScheduleCalendar from "@/components/schedule/ScheduleCalendar.astro";
import ScheduleDayPanel from "@/components/schedule/ScheduleDayPanel.astro";
import ScheduleSummary from "@/components/schedule/ScheduleSummary.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { createClient } from "@/lib/supabase";
import { calendarName } from "@/lib/manager-users";
import { loadAllPages } from "@/lib/team-availability";
import { changedRows, matchesStored } from "@/lib/schedule-day-save";
import { applyOverrides, overrideWarnings, type OverrideWarning } from "@/lib/schedule-override";
import { summarizeSchedule, type ScheduleSummary as DraftSummary } from "@/lib/schedule-summary";
import {
  addMonths,
  calendarWeeks,
  currentStationMonth,
  formatDay,
  formatMonth,
  formatStationInstant,
  monthOfDate,
  monthStart,
  parseDate,
  parseMonth,
  upcomingMonths,
} from "@/lib/availability";
import {
  DAY_CHANGED_ERROR,
  DISCARDED_MESSAGE,
  GENERATED_MESSAGE,
  generatableMonths,
  loadScheduleInputs,
  logScheduleError,
  managerScheduleUrl,
  NO_CHANGES_MESSAGE,
  OVERRIDDEN_MESSAGE,
  OVERRIDE_NOT_SAVED_ERROR,
  parseDayRow,
  PUBLISHED_MESSAGE,
  resolveScheduleFeedbackError,
  SCHEDULE_LOAD_ERROR,
  SCHEDULE_PAGE_SIZE,
  SCHEDULE_PUBLISHED_ERROR,
  scheduleMonths,
  shiftsByStationDay,
  SUPABASE_NOT_CONFIGURED_ERROR,
  UNPUBLISHED_MESSAGE,
  type DayRow,
  type ScheduleMember,
  type ScheduleShiftRow,
  type ScheduleWindowRow,
} from "@/lib/schedule";

// Manager-only through MANAGER_ROUTES in src/lib/route-access.ts; RLS lets only managers read drafts and every
// profile and window. No writes here: generate, discard, override, publish and unpublish are form POSTs to
// /api/manager/schedule/*.
const months = scheduleMonths();
const stationMonth = currentStationMonth();
const [defaultMonth] = upcomingMonths();
const requestedMonth = parseMonth(Astro.url.searchParams.get("month"));
const month = requestedMonth && months.includes(requestedMonth) ? requestedMonth : defaultMonth;
const requestedDay = parseDate(Astro.url.searchParams.get("day"));
// Every calendar date of the month starts one station day, so a date of the month is a valid station day.
const selectedDay = requestedDay && monthOfDate(requestedDay) === month ? requestedDay : monthStart(month);
const canGenerate = generatableMonths().includes(month);

// Result of the last generate, discard, day save, publish or unpublish, from the redirect URL; only known messages are
// shown as-is. `dayStatus` marks the statuses a day save can produce (they belong in the day panel).
const feedbackError = resolveScheduleFeedbackError(Astro.url.searchParams.get("error"));
interface Feedback {
  kind: "error" | "success" | "notice";
  message: string;
}
const feedback: Feedback | null = feedbackError
  ? { kind: "error", message: feedbackError }
  : Astro.url.searchParams.get("generated") === "1"
    ? { kind: "success", message: GENERATED_MESSAGE }
    : Astro.url.searchParams.get("discarded") === "1"
      ? { kind: "success", message: DISCARDED_MESSAGE }
      : Astro.url.searchParams.get("overridden") === "1"
        ? { kind: "success", message: OVERRIDDEN_MESSAGE }
        : Astro.url.searchParams.get("unchanged") === "1"
          ? { kind: "notice", message: NO_CHANGES_MESSAGE }
          : Astro.url.searchParams.get("published") === "1"
            ? { kind: "success", message: PUBLISHED_MESSAGE }
            : Astro.url.searchParams.get("unpublished") === "1"
              ? { kind: "success", message: UNPUBLISHED_MESSAGE }
              : null;
const dayStatus =
  feedbackError !== null ||
  Astro.url.searchParams.get("overridden") === "1" ||
  Astro.url.searchParams.get("unchanged") === "1";
// The confirm step's rows (`&row=<shift>:<was>:<to>`, every shift of the day); null marks a row that does not parse.
const confirmRowParams = Astro.url.searchParams.getAll("row").map(parseDayRow);

let members: ScheduleMember[] = [];
let summary: DraftSummary<ScheduleShiftRow> | null = null;
let shifts: ScheduleShiftRow[] = [];
let draft: { generatedAt: string; publishedAt: string | null } | null = null;
// The previous month's draft shift ending at 06:00 on day 1, shown on day 1 and checked for back-to-back shifts.
let previousNight: ScheduleShiftRow | null = null;
// The next month's draft shift starting at 06:00 on its day 1, checked for back-to-back shifts.
let nextMorning: ScheduleShiftRow | null = null;
let windows: ScheduleWindowRow[] = [];
// month (YYYY-MM) -> locked_at (timestamptz)
const lockedAt = new Map<string, string>();
let lockStateUnknown = false;
// Set when any read failed, so nothing on the page can read as "no draft", "uncovered" or "No shifts".
let scheduleUnknown = false;
let loadError: string | null = null;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  loadError = SUPABASE_NOT_CONFIGURED_ERROR;
  scheduleUnknown = true;
  lockStateUnknown = true;
} else {
  const [inputs, draftResult, shiftsResult, locksResult] = await Promise.all([
    loadScheduleInputs(supabase, month),
    supabase
      .from("schedules")
      .select("month, generated_at, published_at, published_by")
      .eq("month", monthStart(month))
      .maybeSingle(),
    loadAllPages(
      (from, to) =>
        supabase
          .from("schedule_shifts")
          .select("id, starts_at, ends_at, employee_id", { count: "exact" })
          .eq("month", monthStart(month))
          .order("starts_at", { ascending: true })
          .order("id", { ascending: true })
          .range(from, to),
      SCHEDULE_PAGE_SIZE,
    ),
    supabase.from("availability_locks").select("month, locked_at").in("month", months.map(monthStart)),
  ]);

  if (draftResult.error) {
    logScheduleError("could not load the draft", draftResult.error);
  }
  if (shiftsResult.error) {
    logScheduleError("could not load the draft shifts", shiftsResult.error);
  }
  if (locksResult.error) {
    logScheduleError("could not load month locks", locksResult.error);
    lockStateUnknown = true;
  } else {
    for (const lock of locksResult.data) {
      lockedAt.set(lock.month.slice(0, 7), lock.locked_at);
    }
  }

  if (inputs.status === "unknown" || draftResult.error || shiftsResult.data === null || locksResult.error) {
    scheduleUnknown = true;
    loadError = SCHEDULE_LOAD_ERROR;
  } else {
    members = inputs.members;
    previousNight = inputs.previousNight;
    nextMorning = inputs.nextMorning;
    windows = inputs.windows;
    if (draftResult.data) {
      draft = { generatedAt: draftResult.data.generated_at, publishedAt: draftResult.data.published_at };
      shifts = shiftsResult.data;
      summary = summarizeSchedule({ month, members, windows, shifts, previousNight, nextMorning });
    }
  }
}

const membersById = new Map(members.map((member) => [member.id, member]));
// The calendar names a person by their email prefix and shows the full email on hover.
const calendarLabels = new Map(
  members.map((member) => [member.id, { name: calendarName(member), title: member.email || undefined }]),
);
const calendarHref = (day: string): string => managerScheduleUrl({ month, day });
const byStationDay = shiftsByStationDay(shifts);
const selectedShifts = byStationDay.get(selectedDay) ?? [];
// The confirm panel only makes sense for an unpublished draft that can be regenerated.
const confirming =
  Astro.url.searchParams.get("confirm") === "replace" && draft !== null && draft.publishedAt === null && canGenerate;
// Overrides are open on an unpublished draft read in full (the summary is set only then).
const editable = summary !== null && draft !== null && draft.publishedAt === null;

// A day save's result (error, saved, nothing changed) carries `day` and renders in that day's panel while the draft is
// editable; any other status, or one on a published month (its read-only rows show no feedback), stays in the card.
const dayFeedback = feedback && dayStatus && requestedDay === selectedDay && editable ? feedback : null;

// `?confirm=override&row=…`: the warnings are rebuilt from this page's own reads, never taken from the URL. The rows
// must still describe the selected day as stored (else DAY_CHANGED_ERROR), name loaded members, change something and
// introduce at least one warning (else OVERRIDE_NOT_SAVED_ERROR); both errors render in the day panel.
let overrideConfirm: { rows: DayRow[]; warnings: OverrideWarning[] } | null = null;
let confirmError: string | null = null;
if (Astro.url.searchParams.get("confirm") === "override" && editable && summary && !feedback) {
  const rows = confirmRowParams.filter((row): row is DayRow => row !== null);
  const changes = changedRows(rows);
  if (rows.length !== confirmRowParams.length || !matchesStored(rows, selectedShifts)) {
    confirmError = DAY_CHANGED_ERROR;
  } else if (changes.length === 0 || changes.some((row) => row.to !== null && !membersById.has(row.to))) {
    confirmError = OVERRIDE_NOT_SAVED_ERROR;
  } else {
    const after = summarizeSchedule({
      month,
      members,
      windows,
      shifts: applyOverrides(shifts, new Map(changes.map((row) => [row.shift, row.to]))),
      previousNight,
      nextMorning,
    });
    const warnings = overrideWarnings({
      before: summary,
      after,
      shiftIds: new Set(changes.map((row) => row.shift)),
    });
    if (warnings.length > 0) {
      // In the day's start order, so the panel lists the changes as the rows appear.
      const rowsByShift = new Map(rows.map((row) => [row.shift, row]));
      overrideConfirm = {
        rows: selectedShifts.map((shift) => rowsByShift.get(shift.id)).filter((row): row is DayRow => !!row),
        warnings,
      };
    } else {
      confirmError = OVERRIDE_NOT_SAVED_ERROR;
    }
  }
}

// A `?confirm=override` that is not on an editable draft saved nothing; the card says so instead of showing nothing.
const unsavedOverride: Feedback | null =
  Astro.url.searchParams.get("confirm") === "override" && !feedback && !editable
    ? { kind: "error", message: draft?.publishedAt ? SCHEDULE_PUBLISHED_ERROR : OVERRIDE_NOT_SAVED_ERROR }
    : null;
const panelFeedback: Feedback | null = dayFeedback ?? (confirmError ? { kind: "error", message: confirmError } : null);
const cardFeedback = dayFeedback ? null : (feedback ?? unsavedOverride);

const lockedMonths = new Set(lockedAt.keys());
const monthLockedAt = lockedAt.get(month);
const isCurrentMonth = month === stationMonth;
const lockStatus = isCurrentMonth
  ? "In progress — employees can no longer edit this month"
  : lockStateUnknown
    ? "Lock state unknown — the month locks could not be loaded"
    : monthLockedAt
      ? `Locked since ${formatStationInstant(monthLockedAt)}`
      : "Open — employees can still edit";
const monthHref = (option: string): string => managerScheduleUrl({ month: option });
---

<Layout title="Schedule">
  <div class="flex-1 bg-background p-4">
    <!-- Only the calendar uses the desktop width (its cells list who works each shift); the rest stays narrow. -->
    <div class="mx-auto w-full max-w-2xl lg:max-w-6xl">
      <div class="mx-auto w-full max-w-2xl">
        <h1 class="mb-6 text-center text-2xl font-semibold">Schedule</h1>
        {loadError && (
          <Alert variant="destructive" className="mb-4">
            <CircleAlert />
            <AlertDescription>{loadError}</AlertDescription>
          </Alert>
        )}

        <MonthTabs months={months} current={month} lockedMonths={lockedMonths} hrefFor={monthHref} />

        <p class="mb-6 text-center text-sm text-muted-foreground">
          {lockStatus}
          {!isCurrentMonth && (
            <>
              {" · "}
              <a href="/manager/months" class="text-primary underline-offset-4 hover:underline">
                Manage month locks
              </a>
            </>
          )}
        </p>
      </div>

      {!scheduleUnknown && (
        <>
          <div class="mx-auto w-full max-w-2xl">
            <ScheduleActions
              month={month}
              day={selectedDay}
              canGenerate={canGenerate}
              draft={draft}
              daysWithNoOne={summary?.daysWithNoOne.length ?? 0}
              locked={isCurrentMonth || monthLockedAt !== undefined}
              confirming={confirming}
              feedback={cardFeedback}
            />
          </div>

          {summary && (
            <>
              <ScheduleCalendar
                month={month}
                weeks={calendarWeeks(month)}
                selectedDay={selectedDay}
                shiftsByDay={byStationDay}
                labels={calendarLabels}
                hrefFor={calendarHref}
                uncoveredCount={summary.uncovered.length}
                daysWithNoOne={summary.daysWithNoOne}
                outsideAvailability={summary.outsideAvailability}
              />

              <div class="mx-auto w-full max-w-2xl">
                <ScheduleDayPanel
                  selectedLabel={formatDay(selectedDay)}
                  month={month}
                  day={selectedDay}
                  shifts={selectedShifts}
                  members={membersById}
                  editable={editable}
                  feedback={panelFeedback}
                  confirm={overrideConfirm}
                  previousNight={
                    previousNight && selectedDay === monthStart(month)
                      ? { shift: previousNight, monthLabel: formatMonth(addMonths(month, -1)) }
                      : null
                  }
                />

                <ScheduleSummary month={month} summary={summary} members={membersById} />
              </div>
            </>
          )}
        </>
      )}
    </div>
  </div>
</Layout>
