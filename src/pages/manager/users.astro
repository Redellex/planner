---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { APP_ROLES } from "@/lib/roles";
import {
  GENERIC_USERS_LOAD_ERROR,
  logManagerUsersError,
  resolveRoleFeedbackError,
  SUPABASE_NOT_CONFIGURED_ERROR,
} from "@/lib/manager-users";
import type { Tables } from "@/db/database.types";

const { user } = Astro.locals;
// Result of the last role save, from the redirect URL; only known messages are shown as-is.
const feedbackError = resolveRoleFeedbackError(Astro.url.searchParams.get("error"));
const saved = Astro.url.searchParams.get("updated") === "1" && !feedbackError;
// This page failed to read its data; independent of the URL, so a URL error cannot hide it.
let loadError: string | null = null;
let profiles: Pick<Tables<"profiles">, "id" | "email" | "role">[] = [];

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  loadError = SUPABASE_NOT_CONFIGURED_ERROR;
} else {
  // RLS returns every profile for a manager.
  const { data, error: queryError } = await supabase
    .from("profiles")
    .select("id, email, role")
    .order("email", { ascending: true });
  if (queryError) {
    logManagerUsersError("could not load profiles", queryError);
    loadError = GENERIC_USERS_LOAD_ERROR;
  } else {
    profiles = data;
  }
}
const error = loadError ?? feedbackError;
---

<Layout title="Users">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-2xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent">
        Users
      </h1>
      {error && (
        <p role="alert" class="mb-4 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">
          {error}
        </p>
      )}
      {saved && !loadError && (
        <p
          role="status"
          class="mb-4 rounded-lg border border-green-500/30 bg-green-900/30 px-3 py-2 text-sm text-green-300"
        >
          Role updated.
        </p>
      )}
      {profiles.length === 0 ? (
        <p class="text-center text-sm text-blue-100/60">No accounts found.</p>
      ) : (
        <ul class="divide-y divide-white/10">
          {profiles.map((profile) => {
            const isSelf = profile.id === user?.id;
            const selectId = `role-${profile.id}`;
            return (
              <li class="flex flex-wrap items-center justify-between gap-3 py-3">
                <span class="text-sm text-blue-100/90">
                  {profile.email}
                  {isSelf && <span class="ml-2 text-xs font-semibold text-purple-200">(you)</span>}
                </span>
                <form method="POST" action="/api/manager/users/role" class="flex items-center gap-2">
                  <input type="hidden" name="userId" value={profile.id} />
                  <label for={selectId} class="sr-only">
                    Role for {profile.email}
                  </label>
                  <select
                    id={selectId}
                    name="role"
                    class="rounded-lg border border-white/20 bg-white/10 px-2 py-1 text-sm text-white"
                  >
                    {APP_ROLES.map((option) => (
                      <option value={option} selected={option === profile.role} class="text-black">
                        {option}
                      </option>
                    ))}
                  </select>
                  <button
                    type="submit"
                    aria-label={`Save role for ${profile.email}`}
                    class="rounded-lg border border-white/20 bg-white/10 px-3 py-1 text-sm transition-colors hover:bg-white/20"
                  >
                    Save
                  </button>
                </form>
              </li>
            );
          })}
        </ul>
      )}
      <div class="mt-6 text-center">
        <a
          href="/dashboard"
          class="inline-block rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Back to dashboard
        </a>
      </div>
    </div>
  </div>
</Layout>
