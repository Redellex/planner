---
import { CircleAlert, CircleCheck } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import UserRoleRow from "@/components/manager/UserRoleRow.astro";
import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert";
import { buttonVariants } from "@/components/ui/button";
import { createClient } from "@/lib/supabase";
import {
  GENERIC_USERS_LOAD_ERROR,
  logManagerUsersError,
  parseFeedbackUser,
  resolveRoleFeedbackError,
  ROLE_UPDATED_MESSAGE,
  SUPABASE_NOT_CONFIGURED_ERROR,
} from "@/lib/manager-users";
import type { Tables } from "@/db/database.types";

const { user } = Astro.locals;
// Result of the last role save, from the redirect URL; only known messages are shown as-is.
const feedbackError = resolveRoleFeedbackError(Astro.url.searchParams.get("error"));
const saved = Astro.url.searchParams.get("updated") === "1" && !feedbackError;
const feedbackUser = parseFeedbackUser(Astro.url.searchParams.get("user"));
// This page failed to read its data; independent of the URL, so a URL error cannot hide it.
let loadError: string | null = null;
let profiles: Pick<Tables<"profiles">, "id" | "email" | "role">[] = [];

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  loadError = SUPABASE_NOT_CONFIGURED_ERROR;
} else {
  // RLS returns every profile for a manager.
  const { data, error: queryError } = await supabase
    .from("profiles")
    .select("id, email, role")
    .order("email", { ascending: true });
  if (queryError) {
    logManagerUsersError("could not load profiles", queryError);
    loadError = GENERIC_USERS_LOAD_ERROR;
  } else {
    profiles = data;
  }
}

const feedback = feedbackError
  ? { kind: "error" as const, message: feedbackError }
  : saved
    ? { kind: "success" as const, message: ROLE_UPDATED_MESSAGE }
    : null;
// Save feedback belongs to the row it concerns; without a matching row it falls back to the top of the page.
const feedbackInRow = feedback !== null && profiles.some((profile) => profile.id === feedbackUser);
const topFeedback = !loadError && !feedbackInRow ? feedback : null;
---

<Layout title="Users">
  <div class="min-h-screen bg-background p-4">
    <div class="mx-auto w-full max-w-2xl">
      <h1 class="mb-6 text-center text-2xl font-semibold">Users</h1>
      {topFeedback?.kind === "error" && (
        <Alert variant="destructive" className="mb-4">
          <CircleAlert />
          <AlertDescription>{topFeedback.message}</AlertDescription>
        </Alert>
      )}
      {topFeedback?.kind === "success" && (
        <Alert role="status" className="mb-4">
          <CircleCheck />
          <AlertTitle>{topFeedback.message}</AlertTitle>
        </Alert>
      )}

      <section aria-label="Accounts" class="rounded-xl border bg-card p-4 text-card-foreground">
        {loadError ? (
          <Alert variant="destructive">
            <CircleAlert />
            <AlertDescription>{loadError}</AlertDescription>
          </Alert>
        ) : profiles.length === 0 ? (
          <p class="text-center text-sm text-muted-foreground">No accounts found.</p>
        ) : (
          <ul class="divide-y">
            {profiles.map((profile) => (
              <UserRoleRow
                profile={profile}
                isSelf={profile.id === user?.id}
                feedback={profile.id === feedbackUser ? feedback : null}
              />
            ))}
          </ul>
        )}
      </section>

      <div class="mt-6 text-center">
        <a href="/dashboard" class:list={buttonVariants({ variant: "outline" })}>
          Back to dashboard
        </a>
      </div>
    </div>
  </div>
</Layout>
