---
import { CircleAlert, CircleCheck } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import MonthLockRow from "@/components/manager-months/MonthLockRow.astro";
import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert";
import { createClient } from "@/lib/supabase";
import { formatMonth, monthStart, upcomingMonths } from "@/lib/availability";
import {
  buildMonthLocks,
  logMonthsError,
  MONTH_UPDATED_MESSAGE,
  MONTHS_LOAD_ERROR,
  parseMonthParam,
  resolveMonthsFeedbackError,
  SUPABASE_NOT_CONFIGURED_ERROR,
  type MonthLocks,
} from "@/lib/manager-months";

// Result of the last lock write, from the redirect URL; only known messages are shown as-is.
const feedbackError = resolveMonthsFeedbackError(Astro.url.searchParams.get("error"));
const updated = Astro.url.searchParams.get("updated") === "1" && !feedbackError;
const feedbackMonth = parseMonthParam(Astro.url.searchParams.get("month"));
const feedback = feedbackError
  ? { kind: "error" as const, message: feedbackError }
  : updated
    ? { kind: "success" as const, message: MONTH_UPDATED_MESSAGE }
    : null;

const months = upcomingMonths();
// This page failed to read its data; independent of the URL, so a URL error cannot hide it.
let loadError: string | null = null;
let locks: MonthLocks = { state: "unknown" };

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  loadError = SUPABASE_NOT_CONFIGURED_ERROR;
} else {
  const result = await supabase
    .from("availability_locks")
    .select("month, locked_at")
    .in("month", months.map(monthStart));
  locks = buildMonthLocks(result);
  if (locks.state === "unknown") {
    logMonthsError("could not load the month locks", result.error ?? "no data");
    loadError = MONTHS_LOAD_ERROR;
  }
}

// Lock feedback belongs to the row of its month; without a valid upcoming month it falls back to the top.
const topFeedback = loadError === null && feedbackMonth === null ? feedback : null;
---

<Layout title="Months">
  <div class="flex-1 bg-background p-4">
    <div class="mx-auto w-full max-w-2xl">
      <h1 class="mb-2 text-center text-2xl font-semibold">Months</h1>
      <p class="mb-6 text-center text-sm text-muted-foreground">
        Locking a month starts scheduling: employees can no longer change their availability for it.
      </p>
      {topFeedback?.kind === "error" && (
        <Alert variant="destructive" className="mb-4">
          <CircleAlert />
          <AlertDescription>{topFeedback.message}</AlertDescription>
        </Alert>
      )}
      {topFeedback?.kind === "success" && (
        <Alert role="status" className="mb-4">
          <CircleCheck />
          <AlertTitle>{topFeedback.message}</AlertTitle>
        </Alert>
      )}

      <section aria-label="Upcoming months" class="rounded-xl border bg-card p-4 text-card-foreground">
        {loadError !== null || locks.state === "unknown" ? (
          <Alert variant="destructive">
            <CircleAlert />
            <AlertDescription>{loadError ?? MONTHS_LOAD_ERROR}</AlertDescription>
          </Alert>
        ) : (
          <ul class="divide-y">
            {months.map((month) => (
              <MonthLockRow
                month={month}
                label={formatMonth(month)}
                lockedAt={locks.lockedAt.get(month) ?? null}
                feedback={month === feedbackMonth ? feedback : null}
              />
            ))}
          </ul>
        )}
      </section>
    </div>
  </div>
</Layout>

<script>
  // Pending state: disable the clicked Lock/Unlock while its POST is in flight, so a double click cannot send the
  // same lock write twice. Disabling the submitter here does not cancel native submission, and the button carries
  // no `name` (month and action are hidden inputs), so no form data is lost.
  const WRITE_ACTION_PREFIX = "/api/manager/months/";

  document.addEventListener("submit", (event) => {
    const form = event.target;
    // `form.action` is the absolute URL; the attribute is the path as written.
    if (!(form instanceof HTMLFormElement) || !form.getAttribute("action")?.startsWith(WRITE_ACTION_PREFIX)) {
      return;
    }
    const submitter = event.submitter;
    if (submitter instanceof HTMLButtonElement) {
      submitter.disabled = true;
      submitter.setAttribute("aria-busy", "true");
    }
  });

  // Back from the redirect target can restore this page from the bfcache with its buttons still disabled.
  window.addEventListener("pageshow", (event) => {
    if (!event.persisted) {
      return;
    }
    document.querySelectorAll<HTMLButtonElement>(`form[action^="${WRITE_ACTION_PREFIX}"] button`).forEach((button) => {
      button.disabled = false;
      button.removeAttribute("aria-busy");
    });
  });
</script>
