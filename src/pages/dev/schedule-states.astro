---
// Kitchen sink for /manager/schedule: every state of the view, side by side, rendered by the real components from
// fixture data. Dev only (the visual gate for context/changes/generate-monthly-schedule and
// review-override-publish-schedule); 404 in production.
// No database access and no user data: the windows below are wall-clock fixtures, never passed through Date, and the
// drafts are generated from them (or written by hand) on the fly.
import { CircleAlert } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import MonthTabs from "@/components/availability/MonthTabs.astro";
import ScheduleActions from "@/components/schedule/ScheduleActions.astro";
import ScheduleCalendar from "@/components/schedule/ScheduleCalendar.astro";
import ScheduleDayPanel from "@/components/schedule/ScheduleDayPanel.astro";
import ScheduleSummary from "@/components/schedule/ScheduleSummary.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { buildWindow, calendarWeeks, daysInMonth, formatDay } from "@/lib/availability";
import {
  CONFIRM_REPLACE_ERROR,
  DISCARDED_MESSAGE,
  GENERATE_LOAD_ERROR,
  GENERATED_MESSAGE,
  GENERIC_SCHEDULE_WRITE_ERROR,
  INVALID_ASSIGNEE_ERROR,
  INVALID_MONTH_ERROR,
  MONTH_UNLOCKED_ERROR,
  NO_DRAFT_ERROR,
  NO_SCHEDULE_ERROR,
  NOT_PERMITTED_ERROR,
  OVERRIDDEN_MESSAGE,
  PUBLISH_GAPS_ERROR,
  PUBLISHED_MESSAGE,
  SCHEDULE_LOAD_ERROR,
  SCHEDULE_PUBLISHED_ERROR,
  shiftsByStationDay,
  STALE_SHIFT_ERROR,
  SUPABASE_NOT_CONFIGURED_ERROR,
  UNPUBLISHED_MESSAGE,
  type ScheduleMember,
} from "@/lib/schedule";
import { generateSchedule, type GeneratedShift, type ScheduleWindow } from "@/lib/schedule-generator";
import type { OverrideShift, OverrideWarning } from "@/lib/schedule-override";
import { summarizeSchedule, type MemberSummary, type ScheduleSummary as DraftSummary } from "@/lib/schedule-summary";

// Outside dev: 404 with an empty body (the template below renders only in dev). A frontmatter `return` would do,
// but it crashes @typescript-eslint/no-misused-promises in .astro files.
const isDev = import.meta.env.DEV;
if (!isDev) {
  Astro.response.status = 404;
}

// A fixed past month keeps the screenshots stable; every write to it is refused anyway.
const month = "2026-04";
const months = ["2026-03", "2026-04", "2026-05", "2026-06"];
const lockedMonths = new Set(["2026-04"]);
const weeks = calendarWeeks(month);
const generatedAt = "2026-03-20T09:30:00+00:00";
const publishedAt = "2026-03-27T14:05:00+00:00";
const draftCard = { generatedAt, publishedAt: null };
const publishedCard = { generatedAt, publishedAt };

const ALICE: ScheduleMember = {
  id: "00000000-0000-4000-8000-00000000d001",
  email: "alice@example.com",
  role: "employee",
};
const BOB: ScheduleMember = { id: "00000000-0000-4000-8000-00000000d002", email: "bob@example.com", role: "employee" };
const CAROL: ScheduleMember = {
  id: "00000000-0000-4000-8000-00000000d003",
  email: "carol@example.com",
  role: "employee",
};
const DAVE: ScheduleMember = {
  id: "00000000-0000-4000-8000-00000000d005",
  email: "dave@example.com",
  role: "employee",
};
const ERIN: ScheduleMember = {
  id: "00000000-0000-4000-8000-00000000d006",
  email: "erin@example.com",
  role: "employee",
};
const NO_EMAIL: ScheduleMember = { id: "3f2a9c1b-0000-4000-8000-00000000d004", email: "", role: "manager" };
const members = [ALICE, BOB, CAROL, DAVE, ERIN, NO_EMAIL];
// Four people available all month: with only two, the night after a night shift blocks the next 06:00 start, so the
// same person would get every night (see schedule-generator.test.ts).
const fullTeam = [ALICE, BOB, DAVE, ERIN];
const membersById = new Map(members.map((member) => [member.id, member]));

/** A 24h window per day (06:00 to the next 06:00), so the full team can cover the whole month. */
function allMonth(employee_id: string, skip: (date: string) => "skip" | "no-night" | null): ScheduleWindow[] {
  return daysInMonth(month).flatMap((date) => {
    const kind = skip(date);
    if (kind === "skip") return [];
    return [{ employee_id, ...buildWindow(date, "06:00", kind === "no-night" ? "00:00" : "06:00") }];
  });
}

// Fully covered: the full team is available all month; Carol has one 2h window (too short for any shift).
const carolWindow: ScheduleWindow = { employee_id: CAROL.id, ...buildWindow("2026-04-05", "10:00", "12:00") };
const coveredWindows = [...fullTeam.flatMap((member) => allMonth(member.id, () => null)), carolWindow];
// Generated in dev only: outside dev the page is an empty 404 and must not spend Worker CPU on fixtures.
const covered = isDev ? generateSchedule({ month, windows: coveredWindows }).shifts : [];

// Gaps: nobody is available 00:00–06:00 after station day 3, and nobody at all on station day 10.
const NIGHT_GAP_DAY = "2026-04-03";
const EMPTY_DAY = "2026-04-10";
const gapRule = (date: string) => (date === EMPTY_DAY ? "skip" : date === NIGHT_GAP_DAY ? "no-night" : null);
const gapWindows = [...fullTeam.flatMap((member) => allMonth(member.id, gapRule)), carolWindow];
const gaps = isDev ? generateSchedule({ month, windows: gapWindows }).shifts : [];

/** A fixture shift id (a UUID, like a stored row's); `index` keeps the ids of one page unique. */
function fixtureShiftId(index: number): string {
  return `00000000-0000-4000-9000-${String(index).padStart(12, "0")}`;
}
/** Generated shifts as stored rows: the day panel's override forms post a shift id. */
function withIds(shifts: GeneratedShift[], offset: number): OverrideShift[] {
  return shifts.map((shift, index) => ({ id: fixtureShiftId(offset + index), ...shift }));
}

function view(generated: GeneratedShift[], windows: ScheduleWindow[], offset: number) {
  const shifts = withIds(generated, offset);
  const byDay = shiftsByStationDay(shifts);
  const coverage = new Map(
    [...byDay].map(([day, dayShifts]) => [
      day,
      { total: dayShifts.length, assigned: dayShifts.filter((shift) => shift.employee_id !== null).length },
    ]),
  );
  return { byDay, coverage, summary: summarizeSchedule({ month, members, windows, shifts }) };
}
const coveredView = view(covered, isDev ? coveredWindows : [], 0);
const gapsView = view(gaps, isDev ? gapWindows : [], 1000);
const coveredDayShifts = coveredView.byDay.get("2026-04-15") ?? [];
const gapNightShifts = gapsView.byDay.get(NIGHT_GAP_DAY) ?? [];
// The override feedback rows: a saved change on the first covered shift, a refused one on the uncovered night.
const savedShift = coveredDayShifts.at(0) ?? null;
const uncoveredGapShift = gapNightShifts.find((shift) => shift.employee_id === null) ?? null;

// An assignment outside availability never comes from the generator, and the rule breaks it reports depend on the
// team (e.g. two people covering every night), so this summary is written by hand to show every warning at once
// (S-04 overrides will produce them too).
const lateNight: GeneratedShift = {
  starts_at: "2026-04-12T18:00:00",
  ends_at: "2026-04-13T06:00:00",
  employee_id: ALICE.id,
};
const longDay: GeneratedShift = {
  starts_at: "2026-04-14T06:00:00",
  ends_at: "2026-04-14T18:00:00",
  employee_id: ALICE.id,
};
const outside: GeneratedShift = {
  starts_at: "2026-04-20T14:00:00",
  ends_at: "2026-04-20T22:00:00",
  employee_id: BOB.id,
};
// A 1 Apr 06:00 start for the person who worked the 31 Mar night: only a later change to March's draft causes it.
const firstMorning: GeneratedShift = {
  starts_at: "2026-04-01T06:00:00",
  ends_at: "2026-04-01T18:00:00",
  employee_id: ALICE.id,
};
// March's last night as /manager/schedule shows it on 1 April.
const marchLastNight: GeneratedShift = {
  starts_at: "2026-03-31T18:00:00",
  ends_at: "2026-04-01T06:00:00",
  employee_id: BOB.id,
};
// Bob works 06–12 and 12–18 on the same station day (a same-day pair that is also back to back); Dave's 18–06 night
// is followed by his 06:00 start the next morning; Alice's last night touches May's first morning (May's draft has
// her at 06:00 on 1 May). Only overrides, or a later change to the next month's draft, produce these.
const sameDayMorning: GeneratedShift = {
  starts_at: "2026-04-22T06:00:00",
  ends_at: "2026-04-22T12:00:00",
  employee_id: BOB.id,
};
const sameDayAfternoon: GeneratedShift = {
  starts_at: "2026-04-22T12:00:00",
  ends_at: "2026-04-22T18:00:00",
  employee_id: BOB.id,
};
const daveNight: GeneratedShift = {
  starts_at: "2026-04-24T18:00:00",
  ends_at: "2026-04-25T06:00:00",
  employee_id: DAVE.id,
};
const daveNextMorning: GeneratedShift = {
  starts_at: "2026-04-25T06:00:00",
  ends_at: "2026-04-25T12:00:00",
  employee_id: DAVE.id,
};
const aprilLastNight: GeneratedShift = {
  starts_at: "2026-04-30T18:00:00",
  ends_at: "2026-05-01T06:00:00",
  employee_id: ALICE.id,
};
const ruleBreakSummary: DraftSummary = {
  perMember: [
    {
      id: ALICE.id,
      shifts: 34,
      minutes: 360 * 60,
      longCount: 16,
      nightCount: 12,
      hasAvailability: true,
      zeroShifts: false,
    },
    {
      id: BOB.id,
      shifts: 30,
      minutes: 320 * 60,
      longCount: 13,
      nightCount: 9,
      hasAvailability: true,
      zeroShifts: false,
    },
  ],
  uncovered: [],
  daysWithNoOne: [],
  touchesPreviousNight: [firstMorning],
  ruleBreaks: [
    { kind: "night", shift: lateNight, assignee: ALICE.id, eligibleMin: 9 },
    { kind: "long", shift: lateNight, assignee: ALICE.id, eligibleMin: 13 },
    { kind: "long", shift: longDay, assignee: ALICE.id, eligibleMin: 13 },
  ],
  outsideAvailability: [outside],
  sameDay: [{ assignee: BOB.id, shifts: [sameDayMorning, sameDayAfternoon] }],
  backToBack: [
    { assignee: BOB.id, first: sameDayMorning, second: sameDayAfternoon },
    { assignee: DAVE.id, first: daveNight, second: daveNextMorning },
  ],
  touchesNextMorning: [aprilLastNight],
};

// The override confirm panel (`?confirm=override`) with one warning of each kind, written by hand: no single real
// change produces all of them. The night shift (Dave today) is being given to Carol.
const confirmDayShift: OverrideShift = {
  id: fixtureShiftId(2000),
  starts_at: "2026-04-30T06:00:00",
  ends_at: "2026-04-30T18:00:00",
  employee_id: BOB.id,
};
const confirmNightShift: OverrideShift = {
  id: fixtureShiftId(2001),
  starts_at: "2026-04-30T18:00:00",
  ends_at: "2026-05-01T06:00:00",
  employee_id: DAVE.id,
};
const confirmNightAfter: OverrideShift = { ...confirmNightShift, employee_id: CAROL.id };
const confirmFirstMorning: OverrideShift = { id: fixtureShiftId(2002), ...firstMorning };
const confirmWarnings: OverrideWarning[] = [
  { kind: "outside", shift: confirmNightAfter, assignee: CAROL.id },
  { kind: "sameDay", assignee: CAROL.id, shifts: [{ ...confirmDayShift, employee_id: CAROL.id }, confirmNightAfter] },
  {
    kind: "backToBack",
    assignee: CAROL.id,
    first: { ...confirmDayShift, employee_id: CAROL.id },
    second: confirmNightAfter,
  },
  { kind: "previousNight", shift: confirmFirstMorning, assignee: ALICE.id },
  { kind: "nextMorning", shift: confirmNightAfter, assignee: CAROL.id },
  { kind: "fairness", rule: "long", shift: confirmDayShift, assignee: BOB.id, eligibleMin: 2 },
  { kind: "fairness", rule: "night", shift: confirmNightAfter, assignee: CAROL.id, eligibleMin: 1 },
  { kind: "noOne", date: EMPTY_DAY },
];
// The members' counts with the change applied: the fairness lines read the assignee's own count from here.
const confirmCounts: MemberSummary[] = [
  { id: BOB.id, shifts: 9, minutes: 108 * 60, longCount: 4, nightCount: 1, hasAvailability: true, zeroShifts: false },
  { id: CAROL.id, shifts: 5, minutes: 60 * 60, longCount: 3, nightCount: 3, hasAvailability: true, zeroShifts: false },
];

const noDraftStates = [
  { title: "No draft, open month", canGenerate: true, locked: false },
  { title: "No draft, locked month", canGenerate: true, locked: true },
  { title: "Current month, no draft (no generate)", canGenerate: false, locked: true },
];

const draftStates = [
  {
    title: "Draft, every day covered (Publish + Regenerate + Discard)",
    canGenerate: true,
    confirming: false,
    draft: draftCard,
    daysWithNoOne: 0,
    feedback: null,
  },
  {
    title: "Draft with days that have no one (publish notice)",
    canGenerate: true,
    confirming: false,
    draft: draftCard,
    daysWithNoOne: 2,
    feedback: null,
  },
  {
    title: "Draft with 1 day that has no one",
    canGenerate: true,
    confirming: false,
    draft: draftCard,
    daysWithNoOne: 1,
    feedback: null,
  },
  {
    title: "Confirm panel (?confirm=replace)",
    canGenerate: true,
    confirming: true,
    draft: draftCard,
    daysWithNoOne: 2,
    feedback: null,
  },
  {
    title: "Current month draft (Publish + Discard)",
    canGenerate: false,
    confirming: false,
    draft: draftCard,
    daysWithNoOne: 0,
    feedback: null,
  },
  {
    title: "Success: generated",
    canGenerate: true,
    confirming: false,
    draft: draftCard,
    daysWithNoOne: 2,
    feedback: { kind: "success" as const, message: GENERATED_MESSAGE },
  },
  {
    title: "Published (Unpublish only)",
    canGenerate: true,
    confirming: false,
    draft: publishedCard,
    daysWithNoOne: 0,
    feedback: null,
  },
  {
    title: "Success: published",
    canGenerate: true,
    confirming: false,
    draft: publishedCard,
    daysWithNoOne: 0,
    feedback: { kind: "success" as const, message: PUBLISHED_MESSAGE },
  },
  {
    title: "Success: unpublished",
    canGenerate: true,
    confirming: false,
    draft: draftCard,
    daysWithNoOne: 0,
    feedback: { kind: "success" as const, message: UNPUBLISHED_MESSAGE },
  },
];

// Every allow-listed ?error= message, in the state it arrives in (STALE_SHIFT_ERROR renders in its shift's row, below;
// with no such row on the selected day it lands on a draft card like INVALID_ASSIGNEE_ERROR).
const errorStates = [
  { message: INVALID_MONTH_ERROR, draft: null, daysWithNoOne: 0 },
  { message: SUPABASE_NOT_CONFIGURED_ERROR, draft: null, daysWithNoOne: 0 },
  { message: CONFIRM_REPLACE_ERROR, draft: draftCard, daysWithNoOne: 2 },
  { message: GENERATE_LOAD_ERROR, draft: null, daysWithNoOne: 0 },
  { message: NOT_PERMITTED_ERROR, draft: null, daysWithNoOne: 0 },
  { message: MONTH_UNLOCKED_ERROR, draft: null, daysWithNoOne: 0 },
  { message: NO_DRAFT_ERROR, draft: null, daysWithNoOne: 0 },
  { message: GENERIC_SCHEDULE_WRITE_ERROR, draft: draftCard, daysWithNoOne: 2 },
  { message: SCHEDULE_PUBLISHED_ERROR, draft: publishedCard, daysWithNoOne: 0 },
  { message: PUBLISH_GAPS_ERROR, draft: draftCard, daysWithNoOne: 2 },
  { message: NO_SCHEDULE_ERROR, draft: null, daysWithNoOne: 0 },
  { message: INVALID_ASSIGNEE_ERROR, draft: draftCard, daysWithNoOne: 0 },
];
---

{isDev && (
  <Layout title="Schedule states">
    <div class="min-h-screen bg-background p-4">
      <div class="mx-auto flex w-full max-w-6xl flex-col gap-10">
        <header class="flex flex-col gap-1">
          <h1 class="text-2xl font-semibold">Schedule states</h1>
          <p class="text-sm text-muted-foreground">
            Dev-only kitchen sink. Fixture availability for {month}; forms on this page do not submit. Loading — N/A:
            SSR + full-page form POST.
          </p>
        </header>

        <section aria-labelledby="states-unknown" class="flex flex-col gap-3">
          <h2 id="states-unknown" class="text-sm font-medium text-muted-foreground">
            Read unknown: only the load error, the month tabs and the lock status
          </h2>
          <div class="mx-auto w-full max-w-2xl">
            <Alert variant="destructive" className="mb-4">
              <CircleAlert />
              <AlertDescription>{SCHEDULE_LOAD_ERROR}</AlertDescription>
            </Alert>
            <MonthTabs
              months={months}
              current={month}
              lockedMonths={lockedMonths}
              hrefFor={(option) => `/dev/schedule-states?month=${option}`}
            />
            <p class="text-center text-sm text-muted-foreground">
              Lock state unknown — the month locks could not be loaded
            </p>
          </div>
        </section>

        <section aria-labelledby="states-actions" class="flex flex-col gap-3">
          <h2 id="states-actions" class="text-sm font-medium text-muted-foreground">
            Actions
          </h2>
          <div class="grid gap-6 lg:grid-cols-2">
            {noDraftStates.map((state, index) => (
              <div class="flex flex-col gap-2">
                <h3 class="text-xs font-medium tracking-wide text-muted-foreground uppercase">{state.title}</h3>
                <ScheduleActions
                  month={month}
                  day={`${month}-01`}
                  canGenerate={state.canGenerate}
                  draft={null}
                  daysWithNoOne={0}
                  locked={state.locked}
                  confirming={false}
                  feedback={null}
                  idPrefix={`no-draft-${index}-`}
                />
              </div>
            ))}
            {draftStates.map((state, index) => (
              <div class="flex flex-col gap-2">
                <h3 class="text-xs font-medium tracking-wide text-muted-foreground uppercase">{state.title}</h3>
                <ScheduleActions
                  month={month}
                  day={`${month}-01`}
                  canGenerate={state.canGenerate}
                  draft={state.draft}
                  daysWithNoOne={state.daysWithNoOne}
                  locked={true}
                  confirming={state.confirming}
                  feedback={state.feedback}
                  idPrefix={`draft-${index}-`}
                />
              </div>
            ))}
            <div class="flex flex-col gap-2">
              <h3 class="text-xs font-medium tracking-wide text-muted-foreground uppercase">Success: discarded</h3>
              <ScheduleActions
                month={month}
                day={`${month}-01`}
                canGenerate={true}
                draft={null}
                daysWithNoOne={0}
                locked={true}
                confirming={false}
                feedback={{ kind: "success", message: DISCARDED_MESSAGE }}
                idPrefix="discarded-"
              />
            </div>
          </div>
        </section>

        <section aria-labelledby="states-errors" class="flex flex-col gap-3">
          <h2 id="states-errors" class="text-sm font-medium text-muted-foreground">
            Every allow-listed error
          </h2>
          <div class="grid gap-6 lg:grid-cols-2">
            {errorStates.map((state, index) => (
              <ScheduleActions
                month={month}
                day={`${month}-01`}
                canGenerate={true}
                draft={state.draft}
                daysWithNoOne={state.daysWithNoOne}
                locked={true}
                confirming={false}
                feedback={{ kind: "error", message: state.message }}
                idPrefix={`error-${index}-`}
              />
            ))}
          </div>
        </section>

        <section aria-labelledby="states-covered" class="flex flex-col gap-3">
          <h2 id="states-covered" class="text-sm font-medium text-muted-foreground">
            Fully covered draft (generated from fixtures; Carol's 2h window gets no shift)
          </h2>
          <div class="mx-auto w-full max-w-2xl">
            <ScheduleCalendar
              month={month}
              weeks={weeks}
              selectedDay="2026-04-15"
              coverage={coveredView.coverage}
              uncoveredCount={coveredView.summary.uncovered.length}
              daysWithNoOne={coveredView.summary.daysWithNoOne}
            />
            <ScheduleDayPanel
              selectedLabel={formatDay("2026-04-15")}
              month={month}
              day="2026-04-15"
              shifts={coveredDayShifts}
              members={membersById}
              editable={true}
              idPrefix="covered-"
            />
            <div class="mt-6">
              <ScheduleDayPanel
                selectedLabel={formatDay("2026-04-01")}
                month={month}
                day="2026-04-01"
                shifts={coveredView.byDay.get("2026-04-01") ?? []}
                editable={true}
                members={membersById}
                previousNight={{ shift: marchLastNight, monthLabel: "March 2026" }}
                idPrefix="covered-day1-"
              />
            </div>
            <ScheduleSummary month={month} summary={coveredView.summary} members={membersById} idPrefix="covered-" />
          </div>
        </section>

        <section aria-labelledby="states-gaps" class="flex flex-col gap-3">
          <h2 id="states-gaps" class="text-sm font-medium text-muted-foreground">
            Draft with uncovered shifts: night after {formatDay(NIGHT_GAP_DAY)} uncovered, no one on
            {formatDay(EMPTY_DAY)}; zero-shift member (Carol)
          </h2>
          <div class="mx-auto w-full max-w-2xl">
            <ScheduleCalendar
              month={month}
              weeks={weeks}
              selectedDay={NIGHT_GAP_DAY}
              coverage={gapsView.coverage}
              uncoveredCount={gapsView.summary.uncovered.length}
              daysWithNoOne={gapsView.summary.daysWithNoOne}
            />
            <div class="flex flex-col gap-6">
              <ScheduleDayPanel
                selectedLabel={formatDay(NIGHT_GAP_DAY)}
                month={month}
                day={NIGHT_GAP_DAY}
                shifts={gapNightShifts}
                members={membersById}
                editable={true}
                idPrefix="gap-night-"
              />
              <ScheduleDayPanel
                selectedLabel={formatDay(EMPTY_DAY)}
                month={month}
                day={EMPTY_DAY}
                shifts={gapsView.byDay.get(EMPTY_DAY) ?? []}
                members={membersById}
                editable={true}
                idPrefix="gap-empty-"
              />
            </div>
            <ScheduleSummary month={month} summary={gapsView.summary} members={membersById} idPrefix="gaps-" />
          </div>
        </section>

        <section aria-labelledby="states-override" class="flex flex-col gap-3">
          <h2 id="states-override" class="text-sm font-medium text-muted-foreground">
            Overrides: saved, refused, the confirm panel with one warning of each kind, and read-only rows (published
            month)
          </h2>
          <div class="grid gap-6 lg:grid-cols-2">
            <div class="flex flex-col gap-2">
              <h3 class="text-xs font-medium tracking-wide text-muted-foreground uppercase">
                Success in the row (?overridden=1&shift=)
              </h3>
              <ScheduleDayPanel
                selectedLabel={formatDay("2026-04-15")}
                month={month}
                day="2026-04-15"
                shifts={coveredDayShifts}
                members={membersById}
                editable={true}
                feedback={savedShift ? { shiftId: savedShift.id, kind: "success", message: OVERRIDDEN_MESSAGE } : null}
                idPrefix="override-saved-"
              />
            </div>
            <div class="flex flex-col gap-2">
              <h3 class="text-xs font-medium tracking-wide text-muted-foreground uppercase">
                Error in the row (?error=&shift=)
              </h3>
              <ScheduleDayPanel
                selectedLabel={formatDay(NIGHT_GAP_DAY)}
                month={month}
                day={NIGHT_GAP_DAY}
                shifts={gapNightShifts}
                members={membersById}
                editable={true}
                feedback={
                  uncoveredGapShift
                    ? { shiftId: uncoveredGapShift.id, kind: "error", message: STALE_SHIFT_ERROR }
                    : null
                }
                idPrefix="override-error-"
              />
            </div>
            <div class="flex flex-col gap-2">
              <h3 class="text-xs font-medium tracking-wide text-muted-foreground uppercase">
                Confirm panel (?confirm=override&shift=&employee=), every warning kind (hand-written)
              </h3>
              <ScheduleDayPanel
                selectedLabel={formatDay("2026-04-30")}
                month={month}
                day="2026-04-30"
                shifts={[confirmDayShift, confirmNightShift]}
                members={membersById}
                editable={true}
                confirm={{
                  shiftId: confirmNightShift.id,
                  employee: CAROL.id,
                  warnings: confirmWarnings,
                  perMember: confirmCounts,
                }}
                idPrefix="override-confirm-"
              />
            </div>
            <div class="flex flex-col gap-2">
              <h3 class="text-xs font-medium tracking-wide text-muted-foreground uppercase">
                Read-only rows (not editable)
              </h3>
              <ScheduleDayPanel
                selectedLabel={formatDay("2026-04-15")}
                month={month}
                day="2026-04-15"
                shifts={coveredDayShifts}
                members={membersById}
                idPrefix="override-readonly-"
              />
            </div>
          </div>
        </section>

        <section aria-labelledby="states-rule-breaks" class="flex flex-col gap-3">
          <h2 id="states-rule-breaks" class="text-sm font-medium text-muted-foreground">
            Rule breaks, an assignment outside availability, hard-rule exceptions and shifts back to back with the
            previous and the next month (hand-written summary)
          </h2>
          <div class="mx-auto w-full max-w-2xl">
            <ScheduleSummary month={month} summary={ruleBreakSummary} members={membersById} idPrefix="breaks-" />
          </div>
        </section>
      </div>
    </div>
  </Layout>
)}

<script>
  // Fixture forms: keep them inert so a click here never reaches /api/manager/schedule/*.
  document.addEventListener("submit", (event) => {
    event.preventDefault();
  });
</script>
