---
// Kitchen sink for /schedule: every state of the view, rendered by the real components from fixture data. Dev only
// (the visual gate for context/changes/view-published-schedule); 404 in production. No database access and no user
// data: the shifts and names below are fixtures.
import Layout from "@/layouts/Layout.astro";
import MonthTabs from "@/components/availability/MonthTabs.astro";
import PublishedScheduleView from "@/components/published-schedule/PublishedScheduleView.astro";
import { buildWindow, daysInMonth } from "@/lib/availability";
import { publishedScheduleUrl, type PublishedSchedule, type PublishedShift } from "@/lib/published-schedule";

// Outside dev: 404 with an empty body (the template below renders only in dev). A frontmatter `return` would do,
// but it crashes @typescript-eslint/no-misused-promises in .astro files.
const isDev = import.meta.env.DEV;
if (!isDev) {
  Astro.response.status = 404;
}

const month = "2026-04";
const months = ["2026-03", "2026-04", "2026-05", "2026-06"];
const monthHref = (option: string): string => publishedScheduleUrl({ month: option });
const PUBLISHED_AT = "2026-03-28T09:15:00+00:00";

// The viewer is "Ewa"; every station day is 12+12 and the three people rotate, so Ewa works on two days out of three.
const viewer = { id: "00000000-0000-4000-8000-00000000e001", name: "Ewa" };
const people = [
  viewer,
  { id: "00000000-0000-4000-8000-00000000e002", name: "demo-full-b" },
  {
    id: "00000000-0000-4000-8000-00000000e003",
    name: "Tomasz K.",
  },
];
const deleted = people[2];

const coveredShifts: PublishedShift[] = daysInMonth(month).flatMap((day, index) => {
  const day12 = buildWindow(day, "06:00", "18:00");
  const night12 = buildWindow(day, "18:00", "06:00");
  const morning = people[index % 3];
  const night = people[(index + 1) % 3];
  return [
    {
      id: `00000000-0000-4000-8000-${String(index * 2).padStart(12, "0")}`,
      ...day12,
      employee_id: morning.id,
      assignee_name: morning.name,
    },
    {
      id: `00000000-0000-4000-8000-${String(index * 2 + 1).padStart(12, "0")}`,
      ...night12,
      employee_id: night.id,
      assignee_name: night.name,
    },
  ];
});
// Tomasz's account was deleted after publishing: his shifts are Uncovered (on delete set null).
const afterDeletionShifts = coveredShifts.map((shift) =>
  shift.employee_id === deleted.id ? { ...shift, employee_id: null, assignee_name: null } : shift,
);

const covered: PublishedSchedule = { kind: "published", publishedAt: PUBLISHED_AT, shifts: coveredShifts };
const afterDeletion: PublishedSchedule = { kind: "published", publishedAt: PUBLISHED_AT, shifts: afterDeletionShifts };

const states: {
  title: string;
  schedule: PublishedSchedule;
  selectedDay: string;
  isManager: boolean;
}[] = [
  { title: "Load error (unknown)", schedule: { kind: "unknown" }, selectedDay: "2026-04-01", isManager: false },
  {
    title: "Not published (employee)",
    schedule: { kind: "notPublished" },
    selectedDay: "2026-04-01",
    isManager: false,
  },
  {
    title: "Not published (manager, with the link to /manager/schedule)",
    schedule: { kind: "notPublished" },
    selectedDay: "2026-04-01",
    isManager: true,
  },
  {
    title: "Published, fully covered; selected day without an own shift",
    schedule: covered,
    selectedDay: "2026-04-02",
    isManager: false,
  },
  {
    title: "Published; selected day with an own shift",
    schedule: covered,
    selectedDay: "2026-04-01",
    isManager: false,
  },
  {
    title: "Published, then an account was deleted (Uncovered shifts)",
    schedule: afterDeletion,
    selectedDay: "2026-04-03",
    isManager: false,
  },
];
---

{isDev && (
  <Layout title="Published schedule states">
    <div class="min-h-screen bg-background p-4">
      <div class="mx-auto flex w-full max-w-2xl flex-col gap-12 lg:max-w-6xl">
        <header class="mx-auto flex w-full max-w-2xl flex-col gap-1">
          <h1 class="text-2xl font-semibold">Published schedule states</h1>
          <p class="text-sm text-muted-foreground">
            Dev-only kitchen sink. Fixture shifts; the viewer is {viewer.name}. Loading — N/A: SSR, one read per page.
          </p>
        </header>

        {states.map((state, index) => (
          <section aria-labelledby={`state-${index}`} class="flex flex-col gap-3">
            <h2 id={`state-${index}`} class="mx-auto w-full max-w-2xl text-sm font-medium text-muted-foreground">
              {state.title}
            </h2>
            <div class="mx-auto w-full max-w-2xl">
              <MonthTabs months={months} current={month} lockedMonths={new Set()} hrefFor={monthHref} />
            </div>
            <PublishedScheduleView
              month={month}
              selectedDay={state.selectedDay}
              schedule={state.schedule}
              ownEmployeeId={viewer.id}
              isManager={state.isManager}
              idPrefix={`state-${index}-`}
            />
          </section>
        ))}
      </div>
    </div>
  </Layout>
)}
