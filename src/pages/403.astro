---
import Layout from "@/layouts/Layout.astro";
import AccessDeniedPanel from "@/components/system/AccessDeniedPanel.astro";

// Rendered for any method: rewritten /api/manager/* form posts (POST) land here too.
Astro.response.status = 403;
---

<Layout title="Access denied">
  <div class="flex flex-1 items-start justify-center bg-background p-4 sm:items-center">
    <div class="mx-auto w-full max-w-sm">
      <AccessDeniedPanel />
    </div>
  </div>
</Layout>
