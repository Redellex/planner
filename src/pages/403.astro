---
import Layout from "@/layouts/Layout.astro";

// Rendered for any method: rewritten /api/manager/* form posts (POST) land here too.
Astro.response.status = 403;
---

<Layout title="Access denied">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Access denied
      </h1>
      <p class="text-blue-100/80">You don't have access to this page.</p>
      <p class="mt-2 text-sm text-blue-100/50">This area is available to managers only.</p>
      <a
        href="/"
        class="mt-6 inline-block rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
      >
        Back to dashboard
      </a>
    </div>
  </div>
</Layout>
