---
import Layout from "@/layouts/Layout.astro";
import DashboardPanel from "@/components/dashboard/DashboardPanel.astro";
import { navLinksFor } from "@/lib/navigation";

const { user, role } = Astro.locals;
// The same links as the top bar, minus Home: the gate decides, so this grid cannot drift from the navigation.
const links = navLinksFor({ signedIn: user !== null, role }).filter((link) => link.href !== "/");
---

<Layout title="Dashboard">
  <div class="flex-1 bg-background p-4">
    <div class="mx-auto w-full max-w-2xl">
      <DashboardPanel email={user?.email} role={role} links={links} />
    </div>
  </div>
</Layout>
