---
import { CircleAlert } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import AvailabilityCalendar from "@/components/availability/AvailabilityCalendar.astro";
import DayPanel from "@/components/availability/DayPanel.astro";
import MonthTabs from "@/components/availability/MonthTabs.astro";
import type { WindowRow } from "@/components/availability/types";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { createClient } from "@/lib/supabase";
import {
  addMonths,
  calendarWeeks,
  currentStationMonth,
  dateOf,
  formatCarryOver,
  formatDay,
  formatMonth,
  GENERIC_LOAD_ERROR,
  logAvailabilityError,
  monthOfDate,
  monthStart,
  parseDate,
  parseMonth,
  resolveFeedbackError,
  SUPABASE_NOT_CONFIGURED_ERROR,
  upcomingMonths,
} from "@/lib/availability";

const { user } = Astro.locals;
// Result of the user's last write, from the redirect URL; only known messages are shown as-is.
const feedbackError = resolveFeedbackError(Astro.url.searchParams.get("error"));
const saved = Astro.url.searchParams.get("updated") === "1" && !feedbackError;

const months = upcomingMonths();
const [defaultMonth] = months;
const requestedMonth = parseMonth(Astro.url.searchParams.get("month"));
const month = requestedMonth && months.includes(requestedMonth) ? requestedMonth : defaultMonth;
const requestedDay = parseDate(Astro.url.searchParams.get("day"));
const selectedDay = requestedDay && monthOfDate(requestedDay) === month ? requestedDay : monthStart(month);
const weeks = calendarWeeks(month);

let windows: WindowRow[] = [];
// An overnight window from the previous month's last day that runs into day 1 (at most one: windows never overlap).
let carryOver: WindowRow | null = null;
const lockedMonths = new Set<string>();
// Fail closed: when the lock rows cannot be read, render the month read-only.
let lockStateUnknown = false;
// This page failed to read its data; independent of the URL, so a URL error cannot hide it.
let loadError: string | null = null;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  loadError = SUPABASE_NOT_CONFIGURED_ERROR;
} else if (user) {
  const [windowsResult, carryOverResult, locksResult] = await Promise.all([
    // Managers can read every window, so filter to the signed-in user explicitly.
    supabase
      .from("availability_windows")
      .select("id, starts_at, ends_at")
      .eq("employee_id", user.id)
      .gte("starts_at", monthStart(month))
      .lt("starts_at", monthStart(addMonths(month, 1)))
      .order("starts_at", { ascending: true }),
    supabase
      .from("availability_windows")
      .select("id, starts_at, ends_at")
      .eq("employee_id", user.id)
      .lt("starts_at", monthStart(month))
      .gt("ends_at", monthStart(month))
      .limit(1),
    supabase.from("availability_locks").select("month").in("month", months.map(monthStart)),
  ]);

  if (windowsResult.error) {
    logAvailabilityError("could not load windows", windowsResult.error);
    loadError = GENERIC_LOAD_ERROR;
  } else {
    windows = windowsResult.data;
  }
  if (carryOverResult.error) {
    logAvailabilityError("could not load the carry-over window", carryOverResult.error);
    loadError = GENERIC_LOAD_ERROR;
  } else {
    carryOver = carryOverResult.data[0] ?? null;
  }
  if (locksResult.error) {
    lockStateUnknown = true;
    logAvailabilityError("could not load month locks", locksResult.error);
    loadError = GENERIC_LOAD_ERROR;
  } else {
    for (const lock of locksResult.data) {
      lockedMonths.add(lock.month.slice(0, 7));
    }
  }
}

const locked = lockStateUnknown || lockedMonths.has(month);
const windowsByDay = new Map<string, WindowRow[]>();
for (const row of windows) {
  const day = dateOf(row.starts_at);
  windowsByDay.set(day, [...(windowsByDay.get(day) ?? []), row]);
}
const selectedWindows = windowsByDay.get(selectedDay) ?? [];
// Shown read-only on day 1; it is edited from the day it starts on.
const firstDay = monthStart(month);
const carryOverLabel = carryOver ? formatCarryOver(carryOver) : null;
const selectedCarryOver = selectedDay === firstDay ? carryOverLabel : null;
// Windows starting on day 1 before 06:00 belong to the previous month's last station night (the schedule reads them
// for that month), so RLS freezes them while the previous month is running or locked.
const previousMonth = addMonths(month, -1);
const previousMonthClosed =
  lockStateUnknown || previousMonth === currentStationMonth() || lockedMonths.has(previousMonth);
const stationNightNotice =
  selectedDay === firstDay && previousMonthClosed
    ? `Windows starting before 06:00 on this day count for ${formatMonth(previousMonth)}'s last night shift and can no longer be changed.`
    : null;
const selectedLabel = formatDay(selectedDay);
// Write feedback belongs to the day panel; a load failure is shown separately at the top.
const feedback = feedbackError
  ? { kind: "error" as const, message: feedbackError }
  : saved
    ? { kind: "success" as const, message: "Availability saved." }
    : null;
---

<Layout title="Availability">
  <div class="flex-1 bg-background p-4">
    <div class="mx-auto w-full max-w-2xl">
      <h1 class="mb-6 text-center text-2xl font-semibold">Availability</h1>
      {loadError && (
        <Alert variant="destructive" className="mb-4">
          <CircleAlert />
          <AlertDescription>{loadError}</AlertDescription>
        </Alert>
      )}

      <MonthTabs months={months} current={month} lockedMonths={lockedMonths} />

      <AvailabilityCalendar
        month={month}
        weeks={weeks}
        windowsByDay={windowsByDay}
        carryOver={carryOver}
        carryOverLabel={carryOverLabel}
        selectedDay={selectedDay}
      />

      <DayPanel
        month={month}
        selectedDay={selectedDay}
        selectedLabel={selectedLabel}
        windows={selectedWindows}
        carryOverText={selectedCarryOver}
        stationNightNotice={stationNightNotice}
        locked={locked}
        lockStateUnknown={lockStateUnknown}
        feedback={feedback}
      />
    </div>
  </div>
</Layout>

<script>
  // Pending state: disable the clicked submit button while its POST is in flight, so a double click cannot
  // send the write twice (the second one would redirect with a false "Overlaps…" / "Not found…" error).
  // Disabling the submitter here does not cancel native submission, and the buttons carry no `name`, so no
  // form data is lost.
  const WRITE_ACTION_PREFIX = "/api/availability/";

  document.addEventListener("submit", (event) => {
    const form = event.target;
    // `form.action` is the absolute URL; the attribute is the path as written.
    if (!(form instanceof HTMLFormElement) || !form.getAttribute("action")?.startsWith(WRITE_ACTION_PREFIX)) {
      return;
    }
    const submitter = event.submitter;
    if (submitter instanceof HTMLButtonElement) {
      submitter.disabled = true;
      submitter.setAttribute("aria-busy", "true");
    }
  });

  // Back from the redirect target can restore this page from the bfcache with its buttons still disabled.
  window.addEventListener("pageshow", (event) => {
    if (!event.persisted) {
      return;
    }
    document.querySelectorAll<HTMLButtonElement>(`form[action^="${WRITE_ACTION_PREFIX}"] button`).forEach((button) => {
      button.disabled = false;
      button.removeAttribute("aria-busy");
    });
  });
</script>
