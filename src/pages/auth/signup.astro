---
import Layout from "@/layouts/Layout.astro";
import AuthPanel from "@/components/auth/AuthPanel.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { resolveAuthFeedbackError } from "@/lib/auth-feedback";

// The redirect's `?error=` is user-controlled: only sign-up messages are shown as-is, anything else is generic.
const serverError = resolveAuthFeedbackError("signup", Astro.url.searchParams.get("error"));
---

<Layout title="Sign up">
  <AuthPanel title="Sign up">
    <SignUpForm serverError={serverError} client:load />
    <Fragment slot="footer">
      Already have an account?{" "}
      <a
        href="/auth/signin"
        class="rounded-sm text-primary underline-offset-4 outline-none hover:underline focus-visible:ring-3 focus-visible:ring-ring/50"
      >
        Sign in
      </a>
    </Fragment>
  </AuthPanel>
</Layout>
