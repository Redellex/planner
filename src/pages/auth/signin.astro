---
import Layout from "@/layouts/Layout.astro";
import AuthPanel from "@/components/auth/AuthPanel.astro";
import SignInForm from "@/components/auth/SignInForm";
import { resolveAuthFeedbackError } from "@/lib/auth-feedback";

// The redirect's `?error=` is user-controlled: only sign-in messages are shown as-is, anything else is generic.
const serverError = resolveAuthFeedbackError("signin", Astro.url.searchParams.get("error"));
---

<Layout title="Sign in">
  <AuthPanel title="Sign in">
    <SignInForm serverError={serverError} client:load />
    <Fragment slot="footer">
      Don't have an account?{" "}
      <a
        href="/auth/signup"
        class="rounded-sm text-primary underline-offset-4 outline-none hover:underline focus-visible:ring-3 focus-visible:ring-ring/50"
      >
        Sign up
      </a>
    </Fragment>
  </AuthPanel>
</Layout>
