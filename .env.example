SUPABASE_URL=###
SUPABASE_KEY=###
EXA_API_KEY=###
# Optional: Sentry error reporting for the Worker (src/worker.ts). Unset = disabled. Production sets it as a wrangler secret.
SENTRY_DSN=

# E2E (Playwright) reads .dev.vars.e2e, not this file: the local stack's SUPABASE_URL/SUPABASE_KEY plus these two.
E2E_USERNAME=
E2E_PASSWORD=
